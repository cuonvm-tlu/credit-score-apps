{
  // File này điều khiển cách anonymize-svc thực thi các lần chạy Differential Privacy.
  // Dùng mode=single để chạy một profile, hoặc mode=batch để chạy nhiều profile trong cùng một lần xử lý.
  "mode": "batch",

  // Tên profile được sử dụng khi mode là 'single'.
  // Tên này phải tồn tại trong object profiles.
  "active_profile": "baseline_adult",

  // Danh sách tên profile theo thứ tự sẽ được chạy khi mode là 'batch'.
  // Phục vụ việc so sánh nhiều bộ tham số trong cùng một lần chạy.
  "batch_profiles": [
    "baseline_adult",
    "privacy_strict",
    "utility_focused"
  ],

  // Nếu true, batch sẽ dừng ngay khi một profile lỗi.
  // Nếu false, pipeline tiếp tục với các profile còn lại.
  "stop_on_error": false,

  // Mẫu tên file output DP.
  // Các placeholder hỗ trợ: {base}, {profile}, {epsilon}, {source_version}, {run_version}.
  "output_name_template": "{base}_dp_{profile}_e{epsilon}_src{source_version}_run{run_version}.parquet",

  // Mỗi key cấp cao nhất trong object này là một bộ tham số DP có thể được đem ra chạy.
  "profiles": {
    "baseline_adult": {
      // Profile cơ sở, tương ứng với hành vi runtime mặc định hiện tại cho bộ dữ liệu Adult.

      // Nếu false, profile này sẽ bị bỏ qua ngay cả khi được chọn bởi active_profile hoặc batch_profiles.
      "enabled": true,

      // Cơ chế DP sẽ sử dụng.
      // Hỗ trợ: laplace | exponential | above_threshold | mixed
      "mechanism": "mixed",

      // Mixed pipeline: cột số dùng Laplace.
      "numeric_mechanism": "laplace",

      // Mixed pipeline: cột phân loại dùng Exponential.
      "categorical_mechanism": "exponential",

      // Có thể chỉ rõ cột categorical; nếu bỏ qua, hệ thống tự phát hiện.
      "categorical_columns": [
        "workclass",
        "education",
        "marital-status",
        "occupation",
        "relationship",
        "race",
        "sex",
        "native-country"
      ],

      // Privacy budget chính.
      // Epsilon nhỏ hơn nghĩa là privacy mạnh hơn và nhiều noise hơn.
      // Epsilon lớn hơn nghĩa là privacy yếu hơn và ít noise hơn.
      "epsilon": 0.3,

      // Tham số delta cho (epsilon, delta)-DP.
      // Dùng 0.0 nếu muốn pure DP.
      "delta": 0.0,

      // Chỉ dùng khi mechanism = above_threshold.
      // Nếu thiếu, hệ thống tự dùng median của từng cột làm threshold.
      "above_threshold_values": {
        "age": 38.0,
        "education-num": 10.0,
        "capital-gain": 0.0,
        "capital-loss": 0.0,
        "hours-per-week": 40.0
      },

      // Chỉ dùng khi mechanism = above_threshold.
      // false: bản ghi dưới threshold giữ nguyên giá trị gốc.
      // true: bản ghi dưới threshold sẽ trả về null.
      "above_threshold_return_none": false,

      // Mixed pipeline: các rule threshold sinh ra cột kết quả mới.
      "threshold_rules": [
        {
          "column": "age",
          "threshold": 38.0,
          "mode": "flag",
          "result_column": "rule_age_above_38"
        },
        {
          "column": "hours-per-week",
          "threshold": 40.0,
          "mode": "flag",
          "result_column": "rule_hours_above_40"
        }
      ],

      // Ngưỡng epsilon tối đa được lớp integration sử dụng cho một thuộc tính số đơn lẻ.
      "max_epsilon_per_attribute": 0.1,

      // Sensitivity cho từng cột số.
      // Sensitivity càng cao thì noise được thêm vào càng lớn với cùng một epsilon.
      "numerical_sensitivity": {
        "age": 100.0,
        "education-num": 16.0,
        "capital-gain": 100000.0,
        "capital-loss": 5000.0,
        "hours-per-week": 168.0
      },

      // Ngưỡng clipping tùy chọn cho từng cột số.
      // Hiện đang được lưu ở đây để theo dõi thí nghiệm và mở rộng sau này.
      "clipping_ranges": {
        "age": [0, 100],
        "education-num": [0, 16],
        "capital-gain": [0, 100000],
        "capital-loss": [0, 5000],
        "hours-per-week": [0, 168]
      },

      "notes": "Current baseline configuration equivalent to the existing runtime setting."
    },

    "privacy_strict": {
      // Profile dùng để so sánh, nhấn mạnh privacy mạnh hơn bằng cách giảm epsilon.
      "enabled": true,
      "mechanism": "mixed",
      "numeric_mechanism": "laplace",
      "categorical_mechanism": "exponential",
      "categorical_columns": [
        "workclass",
        "education",
        "marital-status",
        "occupation",
        "relationship",
        "race",
        "sex",
        "native-country"
      ],
      "epsilon": 0.1,
      "delta": 0.0,
      "above_threshold_values": {
        "age": 38.0,
        "education-num": 10.0,
        "capital-gain": 0.0,
        "capital-loss": 0.0,
        "hours-per-week": 40.0
      },
      "above_threshold_return_none": false,
      "threshold_rules": [
        {
          "column": "age",
          "threshold": 38.0,
          "mode": "flag",
          "result_column": "rule_age_above_38"
        },
        {
          "column": "hours-per-week",
          "threshold": 40.0,
          "mode": "flag",
          "result_column": "rule_hours_above_40"
        }
      ],
      "max_epsilon_per_attribute": 0.05,

      // Giá trị sensitivity được dùng lại từ profile baseline để tách riêng ảnh hưởng của privacy budget khi so sánh.
      "numerical_sensitivity": {
        "age": 100.0,
        "education-num": 16.0,
        "capital-gain": 100000.0,
        "capital-loss": 5000.0,
        "hours-per-week": 168.0
      },

      "notes": "Stronger privacy, larger noise. Useful for comparison runs."
    },

    "utility_focused": {
      // Profile dùng để so sánh, ưu tiên utility bằng cách tăng epsilon
      // và phân bổ budget thủ công nhiều hơn cho một số cột.
      "enabled": true,
      "mechanism": "mixed",
      "numeric_mechanism": "laplace",
      "categorical_mechanism": "exponential",
      "categorical_columns": [
        "workclass",
        "education",
        "marital-status",
        "occupation",
        "relationship",
        "race",
        "sex",
        "native-country"
      ],
      "epsilon": 0.7,
      "delta": 0.0,
      "above_threshold_values": {
        "age": 38.0,
        "education-num": 10.0,
        "capital-gain": 0.0,
        "capital-loss": 0.0,
        "hours-per-week": 40.0
      },
      "above_threshold_return_none": false,
      "threshold_rules": [
        {
          "column": "age",
          "threshold": 38.0,
          "mode": "flag",
          "result_column": "rule_age_above_38"
        },
        {
          "column": "hours-per-week",
          "threshold": 40.0,
          "mode": "flag",
          "result_column": "rule_hours_above_40"
        }
      ],
      "max_epsilon_per_attribute": 0.2,

      "categorical_epsilon_allocation": {
        "workclass": 0.08,
        "education": 0.08,
        "marital-status": 0.08,
        "occupation": 0.08,
        "relationship": 0.08,
        "race": 0.08,
        "sex": 0.08,
        "native-country": 0.08
      },

      // Giá trị sensitivity cho các cột số.
      // Các giá trị này vẫn được dùng ngay cả khi có epsilon_allocation tùy chỉnh.
      "numerical_sensitivity": {
        "age": 100.0,
        "education-num": 16.0,
        "capital-gain": 100000.0,
        "capital-loss": 5000.0,
        "hours-per-week": 168.0
      },

      // Cách chia epsilon tùy chọn theo từng cột.
      // Nếu bỏ qua, epsilon sẽ được chia đều cho các cột số hợp lệ.
      "epsilon_allocation": {
        "age": 0.1,
        "education-num": 0.1,
        "capital-gain": 0.2,
        "capital-loss": 0.1,
        "hours-per-week": 0.2
      },

      "notes": "Weaker privacy, less noise, plus manual allocation for comparison."
    }
  }
}
